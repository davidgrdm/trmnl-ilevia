<div class="layout layout--col layout--top layout--stretch">
  <div class="ilv">
    {% if has_metro %}
      {% assign d = m.directions.first %}
      <div class="ilv-head">
        <span class="ilv-badge ilv-badge--metro">{{ d.line }}</span>
        <div class="ilv-min0">
          <div class="ilv-name">{{ m.station }}</div>
          <div class="ilv-sub">→ {{ d.terminus }}</div>
        </div>
      </div>
      <div class="ilv-fill">
        {% if d.ended %}
          <div class="ilv-meta"><b>Service terminé</b>{% if d.next_first %}<br>Reprise à {{ d.next_first }}{% endif %}</div>
        {% else %}
          <div class="ilv-times">
            {% for dep in d.departures limit: 3 %}
            <div>
              <div class="ilv-time ilv-time--md">{{ dep.time }}</div>
              {% if dep.arrival %}<div class="ilv-arr">arr. {{ dep.arrival }}</div>{% endif %}
            </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% elsif has_surface %}
      {% comment %} Bus seul : le nom de l'arrêt passe dans la barre du bas pour gagner une ligne {% endcomment %}
      <div class="ilv-fill">
      {% for g in s.groups limit: 2 %}
        <div class="ilv-group">
          <div class="ilv-head">
            <span class="ilv-badge ilv-badge--sm">{{ g.line }}</span>
            <span class="ilv-dir">{{ g.direction }}</span>
          </div>
          <div class="ilv-deps ilv-deps--sm">{% for t in g.times limit: 3 %}<span>{{ t }}</span>{% endfor %}</div>
        </div>
      {% else %}
        <div class="ilv-empty">{{ ilv_empty }}</div>
      {% endfor %}
      </div>
    {% endif %}

    {% if ilevia.alert_count > 0 %}
      {% assign a = ilevia.alerts.first %}
      <div class="ilv-alert {% if a.severe %}ilv-alert--severe{% endif %}">
        <span class="ilv-badge ilv-badge--sm">{{ a.line }}</span>
        <div class="ilv-alert-text ilv-alert-text--1">{{ a.text }}</div>
      </div>
    {% else %}
      <div class="ilv-ok"><span class="ilv-badge ilv-badge--sm">OK</span> Trafic normal</div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <img class="image" src="{{ ilv_icon }}" />
  <span class="title">Ilévia</span>
  <span class="instance">{% if has_metro == false and has_surface %}{{ s.stop }} · {% endif %}{{ ilevia.updated }}</span>
</div>
