<div class="layout layout--col layout--top layout--stretch">
  <div class="ilv{% if ilevia.alert_count > 0 %} ilv--alert{% endif %}">
    <div class="ilv-row">
      {% if has_metro %}
      {% assign d = m.directions.first %}
      <div class="ilv-col">
        <div class="ilv-head">
          <span class="ilv-badge ilv-badge--metro">{{ d.line }}</span>
          <div class="ilv-min0">
            <div class="ilv-name">{{ m.station }}</div>
            <div class="ilv-sub">→ {{ d.terminus }}</div>
          </div>
        </div>
        <div class="ilv-fill">
          {% if d.ended %}
            <div class="ilv-meta"><b>Service terminé</b>{% if d.next_first %} · reprise {{ d.next_first }}{% endif %}</div>
          {% else %}
            <div class="ilv-times">
              {% for dep in d.departures limit: 2 %}
              <div>
                <div class="ilv-time{% if has_surface %} ilv-time--md{% endif %}">{{ dep.time }}</div>
                {% if dep.arrival %}<div class="ilv-arr">arr. {{ dep.arrival }}</div>{% endif %}
              </div>
              {% endfor %}
            </div>
          {% endif %}
        </div>
      </div>
      {% endif %}

      {% if has_surface %}
      <div class="ilv-col">
        <div class="ilv-head"><span class="ilv-badge ilv-badge--sm">BUS</span><div class="ilv-name">{{ s.stop }}</div></div>
        {% if s.empty %}
          <div class="ilv-fill"><div class="ilv-empty">{{ ilv_empty }}</div></div>
        {% else %}
          {% if has_metro %}{% assign gmax = 2 %}{% else %}{% assign gmax = 4 %}{% endif %}{% if ilevia.alert_count > 0 %}{% if has_metro %}{% assign gmax = 1 %}{% else %}{% assign gmax = 2 %}{% endif %}{% endif %}
          <div class="ilv-fill{% unless has_metro %} ilv-groups--2col{% endunless %}">
          {% for g in s.groups limit: gmax %}
            <div class="ilv-group">
              <div class="ilv-head">
                <span class="ilv-badge ilv-badge--sm">{{ g.line }}</span>
                <span class="ilv-dir">{{ g.direction }}</span>
              </div>
              <div class="ilv-deps ilv-deps--sm">{% for t in g.times limit: 3 %}<span>{{ t }}</span>{% endfor %}</div>
            </div>
          {% endfor %}
          </div>
        {% endif %}
      </div>
      {% endif %}
    </div>

    {% if ilevia.alert_count > 0 %}
      {% assign a = ilevia.alerts.first %}
      <div class="ilv-card{% if a.severe %} ilv-card--severe{% endif %} ilv-card--compact">
        <div class="ilv-card-head"><span class="ilv-badge ilv-badge--sm">{{ a.line }}</span><span>{{ a.label }}</span>{% if ilevia.alert_count > 1 %}<span class="ilv-card-more">+{{ ilevia.alert_count | minus: 1 }} autre{% if ilevia.alert_count > 2 %}s{% endif %}</span>{% endif %}</div>
        <div class="ilv-card-body ilv-clamp-2">{{ a.short }}</div>
      </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <img class="image" src="{{ ilv_icon }}" />
  <span class="title">Ilévia</span>
  <span class="instance">màj {{ ilevia.updated }}</span>
</div>
