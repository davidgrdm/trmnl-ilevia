<div class="layout layout--col layout--top layout--stretch">
  <div class="ilv">
    {% if ilevia.configured != true %}
      <div class="ilv-empty">Choisissez une station de métro et/ou un arrêt de bus/tram dans les réglages du plugin.</div>
    {% endif %}

    <div class="ilv-row">
      {% if has_metro %}
      <div class="ilv-col" {% if has_surface %}style="flex: 1.15 1 0"{% endif %}>
        {% if m.directions.size > 1 %}
          <div class="ilv-head"><div class="ilv-name">{{ m.station }}</div></div>
          {% for d in m.directions limit: 4 %}
            <div class="ilv-dotted"></div>
            <div class="ilv-head">
              <span class="ilv-badge ilv-badge--metro">{{ d.line }}</span>
              <div style="min-width:0; flex:1">
                <div class="ilv-sub" style="color:#000"><b>→ {{ d.terminus }}</b>{% if d.frequency %} · {{ d.frequency }}{% endif %}</div>
                {% if d.ended %}
                  <div class="ilv-meta">Service terminé{% if d.next_first %} · reprise {{ d.next_first }}{% endif %}</div>
                {% else %}
                  <div class="ilv-dep" style="font-size:22px">{{ d.departures | map: "time" | slice: 0, 4 | join: "  " }}</div>
                {% endif %}
              </div>
            </div>
          {% endfor %}
        {% endif %}
        {% for d in m.directions limit: 1 %}{% if m.directions.size > 1 %}{% break %}{% endif %}
          <div class="ilv-head">
            <span class="ilv-badge ilv-badge--metro">{{ d.line }}</span>
            <div style="min-width:0">
              <div class="ilv-name">{{ m.station }}</div>
              <div class="ilv-sub">→ {{ d.terminus }}{% if d.destination and d.destination != d.terminus %} · arrivée {{ d.destination }}{% endif %}</div>
            </div>
          </div>
          {% if d.ended %}
            <div class="ilv-meta"><b>Service terminé</b>{% if d.next_first %} · premier métro à {{ d.next_first }}{% endif %}</div>
          {% else %}
            {% assign n = 9 %}{% assign tsize = "" %}
            <div class="ilv-times">
              {% for dep in d.departures limit: n %}
              <div>
                <div class="ilv-time {{ tsize }}">{{ dep.time }}</div>
                {% if dep.arrival %}<div class="ilv-arr">arr. {{ dep.arrival }}</div>{% elsif dep.partial %}<div class="ilv-arr">→ {{ dep.headsign }}</div>{% endif %}
              </div>
              {% endfor %}
            </div>
            <div class="ilv-meta">
              {% if d.frequency %}Fréquence {{ d.frequency }}{% endif %}{% if d.travel_minutes %} · trajet {{ d.travel_minutes }} min{% endif %}{% if d.last %} · dernier {{ d.last }}{% endif %}
            </div>
          {% endif %}
        {% endfor %}
        <div class="ilv-sub">Horaires théoriques (pas de temps réel métro en open data)</div>
      </div>
      {% endif %}

      {% if has_surface %}
      <div class="ilv-col">
        <div class="ilv-head">
          <span class="ilv-badge">BUS</span>
          <div class="ilv-name">{{ s.stop }}</div>
        </div>
        {% if s.empty %}
          <div class="ilv-empty">{{ ilv_empty }}</div>
        {% else %}
          <div>
          {% if has_metro %}{% assign gmax = 7 %}{% else %}{% assign gmax = 10 %}{% endif %}
          {% for g in s.groups limit: gmax %}
            <div class="ilv-line">
              <span class="ilv-badge ilv-badge--sm">{{ g.line }}</span>
              <span class="ilv-dir">{{ g.direction }}</span>
              <span class="ilv-dep">{{ g.times | slice: 0, 3 | join: "  " }}</span>
            </div>
          {% endfor %}
          </div>
        {% endif %}
        {% if s.ambiguous.size > 0 %}<div class="ilv-sub">Autres arrêts trouvés : {{ s.ambiguous | join: ", " }}</div>{% endif %}
      </div>
      {% endif %}
    </div>

    {% if ilevia.alert_count > 0 %}
      {% for a in ilevia.alerts limit: 2 %}
      <div class="ilv-alert {% if a.severe %}ilv-alert--severe{% endif %}">
        <span class="ilv-badge ilv-badge--sm">{{ a.line }}</span>
        <div class="ilv-alert-text">{{ a.text }}</div>
      </div>
      {% endfor %}
    {% elsif ilevia.configured %}
      <div class="ilv-ok"><span class="ilv-badge ilv-badge--sm">OK</span> Aucune perturbation signalée sur vos lignes</div>
    {% endif %}
    {% if ilevia.errors.size > 0 %}<div class="ilv-sub">{{ ilevia.errors | join: " · " }}</div>{% endif %}
  </div>
</div>

<div class="title_bar">
  <img class="image" src="{{ ilv_icon }}" />
  <span class="title">Ilévia</span>
  <span class="instance">mis à jour à {{ ilevia.updated }}</span>
</div>
