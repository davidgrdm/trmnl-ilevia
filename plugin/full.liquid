<div class="layout layout--col layout--top layout--stretch">
  <div class="ilv">
    {% if ilevia.configured != true %}
      <div class="ilv-empty">Choisissez une station de métro et/ou un arrêt de bus/tram dans les réglages du plugin.</div>
    {% endif %}

    <div class="ilv-row">
      {% if has_metro %}
      <div class="ilv-col{% if has_surface %} ilv-col--wide{% endif %}">
        {% if m.directions.size > 1 %}
          {% comment %} Plusieurs directions : un bloc par direction, répartis sur la hauteur {% endcomment %}
          <div class="ilv-name">{{ m.station }}</div>
          <div class="ilv-fill">
          {% for d in m.directions limit: 4 %}
            <div class="ilv-dirblock">
              <div class="ilv-head">
                <span class="ilv-badge ilv-badge--metro">{{ d.line }}</span>
                <div class="ilv-min0 ilv-grow">
                  <div class="ilv-sub ilv-strong">→ {{ d.terminus }}</div>
                  {% if d.ended %}
                    <div class="ilv-meta">Service terminé{% if d.next_first %} · reprise {{ d.next_first }}{% endif %}</div>
                  {% else %}
                    <div class="ilv-deps">{% for dep in d.departures limit: 2 %}<span>{{ dep.time }}</span>{% endfor %}</div>
                  {% endif %}
                </div>
              </div>
            </div>
          {% endfor %}
          </div>
        {% else %}
          {% assign d = m.directions.first %}
          <div class="ilv-head">
            <span class="ilv-badge ilv-badge--metro">{{ d.line }}</span>
            <div class="ilv-min0">
              <div class="ilv-name">{{ m.station }}</div>
              <div class="ilv-sub">→ {{ d.terminus }}</div>
            </div>
          </div>
          <div class="ilv-fill">
            {% if d.ended %}
              <div class="ilv-meta"><b>Service terminé</b>{% if d.next_first %}<br>Premier métro à {{ d.next_first }}{% endif %}</div>
            {% else %}
              <div class="ilv-times">
                {% for dep in d.departures limit: 2 %}
                <div>
                  <div class="ilv-time{% unless has_surface %} ilv-time--xl{% endunless %}">{{ dep.time }}</div>
                  {% if dep.arrival %}<div class="ilv-arr">arr. {{ dep.arrival }}</div>{% elsif dep.partial %}<div class="ilv-arr">→ {{ dep.headsign }}</div>{% endif %}
                </div>
                {% endfor %}
              </div>
            {% endif %}
          </div>
          {% if d.destination and d.travel_minutes %}<div class="ilv-foot">Trajet jusqu'à <b>{{ d.destination }}</b> : {{ d.travel_minutes }} min</div>{% endif %}
        {% endif %}
      </div>
      {% endif %}

      {% if has_surface %}
      <div class="ilv-col">
        <div class="ilv-head">
          <span class="ilv-badge">BUS</span>
          <div class="ilv-name">{{ s.stop }}</div>
        </div>
        {% if s.empty %}
          <div class="ilv-fill"><div class="ilv-empty">{{ ilv_empty }}</div></div>
        {% else %}
          {% if has_metro %}{% assign gmax = 4 %}{% else %}{% assign gmax = 8 %}{% endif %}{% if ilv_big %}{% assign gmax = gmax | plus: 1 %}{% endif %}{% if ilevia.alert_count > 0 %}{% assign gmax = gmax | minus: 1 %}{% endif %}
          <div class="ilv-fill{% unless has_metro %} ilv-groups--2col{% endunless %}">
          {% for g in s.groups limit: gmax %}
            <div class="ilv-group">
              <div class="ilv-head">
                <span class="ilv-badge ilv-badge--sm">{{ g.line }}</span>
                <span class="ilv-dir">{{ g.direction }}</span>
              </div>
              <div class="ilv-deps">{% for t in g.times limit: 3 %}<span>{{ t }}</span>{% endfor %}</div>
            </div>
          {% endfor %}
          </div>
        {% endif %}
        {% if s.ambiguous.size > 0 %}<div class="ilv-sub">Autres arrêts : {{ s.ambiguous | join: ", " }}</div>{% endif %}
      </div>
      {% endif %}
    </div>

    {% if ilevia.alert_count > 0 %}
      {% assign a = ilevia.alerts.first %}
      <div class="ilv-card{% if a.severe %} ilv-card--severe{% endif %}">
        <div class="ilv-card-head"><span class="ilv-badge ilv-badge--sm">{{ a.line }}</span><span>{{ a.label }}</span>{% if ilevia.alert_count > 1 %}<span class="ilv-card-more">+{{ ilevia.alert_count | minus: 1 }} autre{% if ilevia.alert_count > 2 %}s{% endif %}</span>{% endif %}</div>
        <div class="ilv-card-body ilv-clamp-4">{% if a.title != "" %}<b>{{ a.title }}.</b> {% endif %}{{ a.text }}</div>
      </div>
    {% elsif ilevia.configured %}
      <div class="ilv-ok"><span class="ilv-badge ilv-badge--sm">OK</span> Aucune perturbation signalée</div>
    {% endif %}
    {% if ilevia.errors.size > 0 %}<div class="ilv-sub">{{ ilevia.errors | join: " · " }}</div>{% endif %}
  </div>
</div>

<div class="title_bar">
  <img class="image" src="{{ ilv_icon }}" />
  <span class="title">Ilévia</span>
  <span class="instance">mis à jour à {{ ilevia.updated }}</span>
</div>
