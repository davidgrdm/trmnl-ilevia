<div class="layout layout--col layout--top layout--stretch">
  <div class="ilv ilv--snug">
    {% if has_metro %}
    {% for d in m.directions limit: 2 %}
      {% unless forloop.first %}<div class="ilv-dotted"></div>{% endunless %}
      <div class="ilv-head">
        <span class="ilv-badge ilv-badge--metro">{{ d.line }}</span>
        <div class="ilv-min0">
          <div class="ilv-name">{{ m.station }}</div>
          <div class="ilv-sub">→ {{ d.terminus }}</div>
        </div>
      </div>
      {% if d.ended %}
        <div class="ilv-meta"><b>Service terminé</b>{% if d.next_first %} · reprise {{ d.next_first }}{% endif %}</div>
      {% else %}
        {% if m.directions.size > 1 or has_surface %}{% assign n = 3 %}{% else %}{% assign n = 6 %}{% endif %}
        <div class="ilv-times">
          {% for dep in d.departures limit: n %}
          <div>
            <div class="ilv-time ilv-time--md">{{ dep.time }}</div>
            {% if dep.arrival %}<div class="ilv-arr">arr. {{ dep.arrival }}</div>{% endif %}
          </div>
          {% endfor %}
        </div>
        <div class="ilv-meta">{% if d.frequency %}{{ d.frequency }}{% endif %}{% if d.last %} · dernier {{ d.last }}{% endif %}</div>
      {% endif %}
    {% endfor %}
    {% endif %}

    {% if has_surface %}
      {% if has_metro %}<div class="ilv-rule"></div>{% endif %}
      <div class="ilv-head"><span class="ilv-badge ilv-badge--sm">BUS</span><div class="ilv-name ilv-fs16">{{ s.stop }}</div></div>
      {% if s.empty %}
        <div class="ilv-empty ilv-fs14">{{ ilv_empty }}</div>
      {% else %}
        <div>
        {% if has_metro %}{% assign gmax = 5 %}{% else %}{% assign gmax = 10 %}{% endif %}{% if ilv_big %}{% assign gmax = gmax | plus: 4 %}{% endif %}
        {% for g in s.groups limit: gmax %}
          <div class="ilv-line">
            <span class="ilv-badge ilv-badge--sm">{{ g.line }}</span>
            <span class="ilv-dir">{{ g.direction }}</span>
            <span class="ilv-dep">{{ g.times | slice: 0, 2 | join: "  " }}</span>
          </div>
        {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    <div class="ilv-grow"></div>
    {% if ilevia.alert_count > 0 %}
      {% assign a = ilevia.alerts.first %}
      <div class="ilv-alert {% if a.severe %}ilv-alert--severe{% endif %}">
        <span class="ilv-badge ilv-badge--sm">{{ a.line }}</span>
        <div class="ilv-alert-text">{{ a.text }}</div>
      </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <img class="image" src="{{ ilv_icon }}" />
  <span class="title">Ilévia</span>
  <span class="instance">màj {{ ilevia.updated }}</span>
</div>
