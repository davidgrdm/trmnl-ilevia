<div class="layout layout--col layout--top layout--stretch">
  <div class="ilv">
    {% if has_metro %}
    <div class="{% if has_surface %}ilv-col{% else %}ilv-fill{% endif %}">
    {% for d in m.directions limit: 2 %}
      <div class="ilv-dirblock">
        <div class="ilv-head">
          <span class="ilv-badge ilv-badge--metro">{{ d.line }}</span>
          <div class="ilv-min0">
            <div class="ilv-name">{{ m.station }}</div>
            <div class="ilv-sub">→ {{ d.terminus }}</div>
          </div>
        </div>
        {% if d.ended %}
          <div class="ilv-meta"><b>Service terminé</b>{% if d.next_first %}<br>Reprise à {{ d.next_first }}{% endif %}</div>
        {% else %}
          <div class="ilv-times">
            {% for dep in d.departures limit: 3 %}
            <div>
              <div class="ilv-time ilv-time--md">{{ dep.time }}</div>
              {% if dep.arrival %}<div class="ilv-arr">arr. {{ dep.arrival }}</div>{% endif %}
            </div>
            {% endfor %}
          </div>
        {% endif %}
      </div>
    {% endfor %}
    </div>
    {% endif %}

    {% if has_surface %}
      {% if has_metro %}<div class="ilv-rule"></div>{% endif %}
      <div class="ilv-head"><span class="ilv-badge ilv-badge--sm">BUS</span><div class="ilv-name">{{ s.stop }}</div></div>
      {% if s.empty %}
        <div class="ilv-fill"><div class="ilv-empty">{{ ilv_empty }}</div></div>
      {% else %}
        {% if has_metro %}{% assign gmax = 3 %}{% else %}{% assign gmax = 5 %}{% endif %}{% if ilv_big %}{% assign gmax = gmax | plus: 1 %}{% endif %}
        <div class="ilv-fill">
        {% for g in s.groups limit: gmax %}
          <div class="ilv-group">
            <div class="ilv-head">
              <span class="ilv-badge ilv-badge--sm">{{ g.line }}</span>
              <span class="ilv-dir">{{ g.direction }}</span>
            </div>
            <div class="ilv-deps ilv-deps--sm">{% for t in g.times limit: 3 %}<span>{{ t }}</span>{% endfor %}</div>
          </div>
        {% endfor %}
        </div>
      {% endif %}
    {% endif %}

    {% if ilevia.alert_count > 0 %}
      {% assign a = ilevia.alerts.first %}
      <div class="ilv-alert {% if a.severe %}ilv-alert--severe{% endif %}">
        <span class="ilv-badge ilv-badge--sm">{{ a.line }}</span>
        <div class="ilv-alert-text{% if has_metro and has_surface %} ilv-alert-text--1{% endif %}">{{ a.text }}</div>
      </div>
    {% endif %}
  </div>
</div>

<div class="title_bar">
  <img class="image" src="{{ ilv_icon }}" />
  <span class="title">Ilévia</span>
  <span class="instance">màj {{ ilevia.updated }}</span>
</div>
